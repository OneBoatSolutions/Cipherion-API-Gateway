// CipSeq database: projects, members, groups, key material and versions,
// invitations, devices, audit events and billing. It is a separate database
// from the auth one (prisma/schema.prisma), so rows reference a user by the
// Better Auth user id without a foreign key.
//
// Commands take --config prisma7.cipseq.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/cipseq"
}

datasource db {
  provider = "postgresql"
}

model Project {
  // Generated by the gateway and sent to the KMS.
  id          String    @id @db.Uuid
  name        String
  description String
  // The one project admin (Better Auth user id).
  adminUserId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Soft delete: the wrapped keys stay, because removing them can't be undone.
  deletedAt   DateTime?

  keys        ProjectKeys?
  keyVersions ProjectKeyVersion[]
  groups      Group[]
  deliveries  EnvelopeDelivery[]

  @@map("project")
}

// The project's current wrapped keys. Only wrapped material is stored, never a
// plaintext key. The encryption key columns are empty until initialisation.
model ProjectKeys {
  projectId                      String   @id @db.Uuid
  wrappedProjectRootKeyIv        String
  wrappedProjectRootKey          String
  wrappedProjectRootKeyTag       String
  wrappedProjectEncryptionKeyIv  String?
  wrappedProjectEncryptionKey    String?
  wrappedProjectEncryptionKeyTag String?
  userPassphraseSalt             String?
  currentKeyVersion              Int?
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  @@map("projectKeys")
}

// One row per key version. It holds no key material: only ProjectKeys has the
// wrapped keys, so an old passphrase can't open anything once it is rotated.
model ProjectKeyVersion {
  projectId String   @db.Uuid
  version   Int
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])

  @@id([projectId, version])
  @@map("projectKeyVersion")
}

// ADMIN is the project admin only. A partial unique index in the migration allows
// one ACTING_ADMIN per group.
enum GroupRole {
  ADMIN
  ACTING_ADMIN
  MEMBER
}

model Group {
  // Generated by the gateway and sent to the KMS.
  id          String    @id @db.Uuid
  projectId   String    @db.Uuid
  name        String
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Soft delete: the wrapped keys stay, because removing them can't be undone.
  deletedAt   DateTime?

  project     Project            @relation(fields: [projectId], references: [id])
  keys        GroupKeys?
  keyVersions GroupKeyVersion[]
  members     GroupMember[]
  invitations GroupInvitation[]
  devices     GroupDevice[]
  envelopes   DeviceEnvelope[]
  envelopeJob EnvelopeJob?
  deliveries  EnvelopeDelivery[]

  @@index([projectId])
  @@map("group")
}

// The group's current wrapped keys. A rotation overwrites them.
model GroupKeys {
  groupId                          String   @id @db.Uuid
  wrappedGroupRootKeyIv            String
  wrappedGroupRootKey              String
  wrappedGroupRootKeyTag           String
  wrappedGroupDataEncryptionKeyIv  String
  wrappedGroupDataEncryptionKey    String
  wrappedGroupDataEncryptionKeyTag String
  // The GdekVersion sent to CreateDeviceEnvelope.
  currentGdekVersion               Int
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id])

  @@map("groupKeys")
}

// One row per version. It holds no key material.
model GroupKeyVersion {
  groupId     String   @db.Uuid
  gdekVersion Int
  createdAt   DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id])

  @@id([groupId, gdekVersion])
  @@map("groupKeyVersion")
}

model GroupMember {
  groupId   String    @db.Uuid
  // Better Auth user id.
  userId    String
  role      GroupRole
  createdAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id])

  @@id([groupId, userId])
  @@index([userId])
  @@map("groupMember")
}

enum InvitationStatus {
  PENDING_APPROVAL
  REJECTED
  PENDING_ACCEPTANCE
  ACCEPTED
  DECLINED
  CANCELLED
}

// A partial unique index in the migration allows one open invitation per group
// and email. An acting admin's invitation waits for the project admin's approval.
model GroupInvitation {
  id               String           @id @default(uuid(7)) @db.Uuid
  groupId          String           @db.Uuid
  // Lower-cased. Matched against the signed-in user's email.
  inviteeEmail     String
  // Better Auth user ids.
  invitedByUserId  String
  status           InvitationStatus
  reviewedByUserId String?
  reviewedAt       DateTime?
  respondedAt      DateTime?
  createdAt        DateTime         @default(now())

  group Group @relation(fields: [groupId], references: [id])

  @@index([inviteeEmail, status])
  @@index([groupId, status])
  @@map("groupInvitation")
}

enum DeviceStatus {
  ACTIVE
  REVOKED
}

// A device is registered once and can be in groups of many projects. REVOKED is
// the device's user revoking it everywhere, and its id can't be used again.
model Device {
  // dvc_ + 43 base64url characters, supplied by the device.
  id        String       @id
  // Better Auth user id.
  userId    String
  name      String?
  // The ML-KEM-1024 public key that envelopes are wrapped for.
  publicKey String
  status    DeviceStatus @default(ACTIVE)
  revokedAt DateTime?
  createdAt DateTime     @default(now())

  groups              GroupDevice[]
  envelopes           DeviceEnvelope[]
  certificates        DeviceCertificate[]
  certificateAttempts DeviceCertificateAttempt[]
  deliveries          EnvelopeDelivery[]

  @@index([userId])
  @@map("device")
}

enum DeviceCertificateOperation {
  ENROL
  RENEW
}

// A device's client certificates, signed by the KMS. Never holds a private key or
// a raw CSR. A partial unique index in the migration allows one current
// certificate per device; retired rows stay as history.
model DeviceCertificate {
  // Lowercase hex without leading zeros, as the KMS returns it.
  serialNumber      String                     @id
  deviceId          String
  // Hex SHA-256 of the CSR DER. It recognises a retry, and being unique across
  // history means a retired CSR can't be issued again.
  csrSha256         String
  // Hex SHA-256 of the DER SubjectPublicKeyInfo of the device's TLS key.
  publicKeySha256   String
  // Leaf first, then any intermediates, without the root. Returned as is on a retry.
  certificatePem    String
  notBefore         DateTime
  notAfter          DateTime
  issuedVia         DeviceCertificateOperation
  renewedFromSerial String?
  // Starts the 24-hour overlap after a renewal. Set once, never reset.
  supersededAt      DateTime?
  revokedAt         DateTime?
  createdAt         DateTime                   @default(now())

  device Device @relation(fields: [deviceId], references: [id])

  @@unique([deviceId, csrSha256])
  @@index([deviceId, createdAt])
  @@map("deviceCertificate")
}

// One row per enrol or renew request, for the rolling limit. Rows past the limit's
// window are removed when the device next asks.
model DeviceCertificateAttempt {
  id        String                     @id @default(uuid(7)) @db.Uuid
  deviceId  String
  operation DeviceCertificateOperation
  createdAt DateTime                   @default(now())

  device Device @relation(fields: [deviceId], references: [id])

  @@index([deviceId, createdAt])
  @@map("deviceCertificateAttempt")
}

// Tells the owner a certificate was issued, because a stolen session can enrol
// one. Shown in GET /workspace until dismissed, and doubles as the email outbox.
// It can't be turned off with UserSettings.securityAlerts.
model DeviceCertificateNotice {
  id               String                     @id @default(uuid(7)) @db.Uuid
  // Better Auth user id.
  userId           String
  kind             DeviceCertificateOperation
  deviceId         String
  serialNumber     String
  createdAt        DateTime                   @default(now())
  dismissedAt      DateTime?
  // Email delivery state, for the retrying worker.
  deliveredAt      DateTime?
  deliveryAttempts Int                        @default(0)
  nextDeliveryAt   DateTime                   @default(now())

  @@index([userId, dismissedAt])
  @@index([deliveredAt, nextDeliveryAt])
  @@map("deviceCertificateNotice")
}

enum GroupDeviceStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  REVOKED
}

// A device's approval for one group. A partial unique index in the migration
// allows one open row per group and device; closed rows stay as history.
model GroupDevice {
  id               String            @id @default(uuid(7)) @db.Uuid
  groupId          String            @db.Uuid
  deviceId         String
  status           GroupDeviceStatus
  // Better Auth user ids.
  reviewedByUserId String?
  reviewedAt       DateTime?
  revokedByUserId  String?
  revokedAt        DateTime?
  createdAt        DateTime          @default(now())

  group  Group  @relation(fields: [groupId], references: [id])
  device Device @relation(fields: [deviceId], references: [id])

  @@index([deviceId, status])
  @@index([groupId, status])
  @@map("groupDevice")
}

// The GDEK wrapped for one device. Soft deleted on revocation. A partial unique
// index in the migration allows one live envelope per group, device and version.
model DeviceEnvelope {
  id              String    @id @default(uuid(7)) @db.Uuid
  groupId         String    @db.Uuid
  deviceId        String
  // Follows the GDEK version.
  envelopeVersion Int
  // Signed by the KMS, so stored exactly as it was returned.
  envelopeJson    String
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  group  Group  @relation(fields: [groupId], references: [id])
  device Device @relation(fields: [deviceId], references: [id])

  @@index([deviceId])
  @@index([groupId, envelopeVersion])
  @@map("deviceEnvelope")
}

enum EnvelopeJobKind {
  ROTATION
  APPROVAL
  RENEWAL
}

enum EnvelopeJobStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum EnvelopeJobFailure {
  WRONG_PASSPHRASE
  KMS_UNAVAILABLE
  INTERRUPTED
}

// The group's latest background envelope job, so the project admin can see it
// running, finished or stopped. It never holds the passphrase, so only the admin
// re-entering it can resume a stopped job. A crash can't record itself, so a
// RUNNING row whose lastActiveAt has gone stale counts as interrupted.
model EnvelopeJob {
  groupId       String              @id @db.Uuid
  // Only the job that wrote this id can update the row, so an older job that's
  // still finishing can't overwrite a newer one.
  jobId         String              @db.Uuid
  kind          EnvelopeJobKind
  gdekVersion   Int
  status        EnvelopeJobStatus
  failureReason EnvelopeJobFailure?
  // How many envelopes were missing when it started.
  envelopeCount Int
  startedAt     DateTime
  lastActiveAt  DateTime
  finishedAt    DateTime?
  // When the project admin dismissed the completed notification.
  dismissedAt   DateTime?

  group Group @relation(fields: [groupId], references: [id])

  @@map("envelopeJob")
}

// No foreign key to Project, so the audit trail outlives the project.
// metadata never holds passphrases or key material.
model AuditEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  // Better Auth user id.
  userId    String
  action    String
  projectId String?  @db.Uuid
  metadata  Json?
  createdAt DateTime @default(now())

  delivery EnvelopeDelivery?

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@map("auditEvent")
}

enum CryptoOperation {
  ENCRYPT
  DECRYPT
}

enum DeliveryStatus {
  APPROVED
  SUPERSEDED
}

enum CryptoDataKind {
  TEXT
  FILE
  STREAM
  OTHER
}

enum CryptoOutcome {
  SUCCESS
  FAILED
}

// One successful envelope delivery, which is what the metrics count: the engine
// fetches an envelope for every operation. Written with its audit row, in the
// same transaction, under the device lock.
model EnvelopeDelivery {
  id                String          @id @default(uuid(7)) @db.Uuid
  // Returned to the engine, and also in the audit row's metadata.
  requestId         String          @unique @db.Uuid
  auditEventId      String          @unique @db.Uuid
  operation         CryptoOperation
  status            DeliveryStatus
  // Better Auth user id, from the session.
  userId            String
  // From the client certificate, never the request.
  deviceId          String
  groupId           String          @db.Uuid
  projectId         String          @db.Uuid
  gdekVersion       Int
  certificateSerial String
  createdAt         DateTime        @default(now())

  // Reported by the engine after the operation, matched by requestId. Null until
  // the engine sends them, and made required later. Untrusted: usage data, not
  // evidence. Never the content, keys or a plain file name.
  dataKind     CryptoDataKind?
  mimeType     String?
  // Files can pass 2 GB.
  sizeBytes    BigInt?
  // A salted hash, never the plain name.
  fileNameHash String?
  outcome      CryptoOutcome?
  errorCode    String?
  // A short description of why it failed, for support. Never content or keys.
  errorReason  String?
  durationMs   Int?
  // The crypto engine's software version that did the operation.
  engineVersion String?
  // When the engine did it; createdAt is when the gateway delivered.
  occurredAt   DateTime?

  auditEvent AuditEvent @relation(fields: [auditEventId], references: [id])
  device     Device     @relation(fields: [deviceId], references: [id])
  group      Group      @relation(fields: [groupId], references: [id])
  project    Project    @relation(fields: [projectId], references: [id])

  @@index([projectId, createdAt])
  @@index([groupId, createdAt])
  @@index([userId, createdAt])
  @@index([deviceId, createdAt])
  @@map("envelopeDelivery")
}
