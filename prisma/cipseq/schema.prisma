// CipSeq database: projects, members, groups, key material and versions,
// invitations, devices, audit events and billing. It is a separate database
// from the auth one (prisma/schema.prisma), so rows reference a user by the
// Better Auth user id without a foreign key.
//
// Commands take --config prisma7.cipseq.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/cipseq"
}

datasource db {
  provider = "postgresql"
}

model Project {
  // Generated by the gateway and sent to the KMS.
  id          String    @id @db.Uuid
  name        String
  description String
  // The one project admin (Better Auth user id).
  adminUserId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Soft delete: the wrapped keys stay, because removing them can't be undone.
  deletedAt   DateTime?

  keys        ProjectKeys?
  keyVersions ProjectKeyVersion[]
  members     ProjectMember[]
  groups      Group[]

  @@map("project")
}

// The project's current wrapped keys. Only wrapped material is stored, never a
// plaintext key. The encryption key columns are empty until initialisation.
model ProjectKeys {
  projectId                      String   @id @db.Uuid
  wrappedProjectRootKeyIv        String
  wrappedProjectRootKey          String
  wrappedProjectRootKeyTag       String
  wrappedProjectEncryptionKeyIv  String?
  wrappedProjectEncryptionKey    String?
  wrappedProjectEncryptionKeyTag String?
  userPassphraseSalt             String?
  currentKeyVersion              Int?
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  @@map("projectKeys")
}

// One row per key version. It holds no key material: only ProjectKeys has the
// wrapped keys, so an old passphrase can't open anything once it is rotated.
model ProjectKeyVersion {
  projectId String   @db.Uuid
  version   Int
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])

  @@id([projectId, version])
  @@map("projectKeyVersion")
}

model ProjectMember {
  projectId String   @db.Uuid
  // Better Auth user id.
  userId    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])

  @@id([projectId, userId])
  @@index([userId])
  @@map("projectMember")
}

enum GroupRole {
  ADMIN
  MEMBER
}

model Group {
  // Generated by the gateway and sent to the KMS.
  id          String    @id @db.Uuid
  projectId   String    @db.Uuid
  name        String
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Soft delete: the wrapped keys stay, because removing them can't be undone.
  deletedAt   DateTime?

  project         Project                     @relation(fields: [projectId], references: [id])
  keys            GroupKeys?
  keyVersions     GroupKeyVersion[]
  members         GroupMember[]
  invitations     GroupInvitation[]
  removalRequests GroupMemberRemovalRequest[]

  @@index([projectId])
  @@map("group")
}

// The group's current wrapped keys. A rotation overwrites them.
model GroupKeys {
  groupId                          String   @id @db.Uuid
  wrappedGroupRootKeyIv            String
  wrappedGroupRootKey              String
  wrappedGroupRootKeyTag           String
  wrappedGroupDataEncryptionKeyIv  String
  wrappedGroupDataEncryptionKey    String
  wrappedGroupDataEncryptionKeyTag String
  // The GdekVersion sent to CreateDeviceEnvelope.
  currentGdekVersion               Int
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id])

  @@map("groupKeys")
}

// One row per version. It holds no key material.
model GroupKeyVersion {
  groupId     String   @db.Uuid
  gdekVersion Int
  createdAt   DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id])

  @@id([groupId, gdekVersion])
  @@map("groupKeyVersion")
}

model GroupMember {
  groupId   String    @db.Uuid
  // Better Auth user id.
  userId    String
  role      GroupRole
  createdAt DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id])

  @@id([groupId, userId])
  @@index([userId])
  @@map("groupMember")
}

enum InvitationStatus {
  PENDING_APPROVAL
  REJECTED
  PENDING_ACCEPTANCE
  ACCEPTED
  DECLINED
  CANCELLED
}

enum RemovalRequestStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

// A partial unique index in the migration allows one open invitation per group
// and email. An acting admin's invitation waits for the project admin's approval.
model GroupInvitation {
  id               String           @id @default(uuid(7)) @db.Uuid
  groupId          String           @db.Uuid
  // Lower-cased. Matched against the signed-in user's email.
  inviteeEmail     String
  // Better Auth user ids.
  invitedByUserId  String
  status           InvitationStatus
  reviewedByUserId String?
  reviewedAt       DateTime?
  respondedAt      DateTime?
  createdAt        DateTime         @default(now())

  group Group @relation(fields: [groupId], references: [id])

  @@index([inviteeEmail, status])
  @@index([groupId, status])
  @@map("groupInvitation")
}

// A partial unique index in the migration allows one pending request per group
// and member.
model GroupMemberRemovalRequest {
  id                String               @id @default(uuid(7)) @db.Uuid
  groupId           String               @db.Uuid
  // Better Auth user ids.
  targetUserId      String
  requestedByUserId String
  status            RemovalRequestStatus
  reviewedByUserId  String?
  reviewedAt        DateTime?
  createdAt         DateTime             @default(now())

  group Group @relation(fields: [groupId], references: [id])

  @@index([groupId, status])
  @@map("groupMemberRemovalRequest")
}

// No foreign key to Project, so the audit trail outlives the project.
// metadata never holds passphrases or key material.
model AuditEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  // Better Auth user id.
  userId    String
  action    String
  projectId String?  @db.Uuid
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@map("auditEvent")
}
