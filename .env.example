# Every setting the gateway reads, with what's required and when.
# Full details: README.md (Environment variables) and docs/environment.md.
# Paths can be relative to the repository root or absolute.

# --- General ----------------------------------------------------------------
# Optional. development | test | production. Default: development
NODE_ENV=development
# Optional. Console port (dashboard, auth, CipSeq). Default: 3000
PORT=3000

# --- Databases (required) ---------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/<DATABASE_NAME>
# Must be a different database from DATABASE_URL when NODE_ENV=production.
CIPSEQ_DATABASE_URL=postgresql://postgres:password@localhost:5432/<CIPSEQ_DATABASE_NAME>

# --- Auth (required) --------------------------------------------------------
# At least 32 characters.
BETTER_AUTH_SECRET=<RANDOM_STRING_MIN_32_CHARS>
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated.
AUTH_TRUSTED_ORIGINS="http://localhost:3000, <Other endpoint>"

# --- Email (required, except NODE_ENV=test) ---------------------------------
# Verification, password reset and password changed emails, over SMTP.
# Locally, Mailpit catches every email (inbox at http://localhost:8025) and
# takes no login:
#   docker run -d --name mailpit -p 1025:1025 -p 8025:8025 axllent/mailpit
EMAIL_HOST=localhost
# 465 uses TLS from the start; 587 upgrades with STARTTLS. Production requires TLS.
EMAIL_PORT=1025
# Optional, both or neither. Your provider's SMTP login. EMAIL_PASS is secret.
# EMAIL_USER=
# EMAIL_PASS=
# Most providers only send as the login's own address.
EMAIL_FROM="Cipherion <no-reply@cipherion.local>"

# --- Google and GitHub sign-in (optional) -----------------------------------
# Each needs both values, or neither. Redirect URIs to register:
#   <BETTER_AUTH_URL>/api/v1/auth/callback/google
#   <BETTER_AUTH_URL>/api/v1/auth/callback/github
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- Redis (required) -------------------------------------------------------
# Must use rediss:// (TLS) when NODE_ENV=production.
REDIS_URL=redis://localhost:6379
# Optional, rediss:// only: a PEM CA to trust for Redis's certificate, for a
# self-signed one such as the local docker Redis. Leave unset when a public CA
# signed it. The certificate is always verified.
# REDIS_URL=rediss://:<password>@localhost:6380
# REDIS_CA_CERT=/home/you/.cipherion/redis-tls/ca.crt

# --- KMS mutual TLS (all required, in every environment) --------------------
# Files come from certs/deploy/gateway/ after `make setup-all` in the KMS repository.
# The host in KMS_ADDRESS must be a name inside the KMS's server.crt.
KMS_ADDRESS=localhost:50051
# Transport CA bundle: ca.crt. NOT device-ca-trust.pem.
KMS_CA_CERT=certs/deploy/gateway/ca.crt
KMS_CLIENT_CERT=certs/deploy/gateway/gateway.crt
# Secret.
KMS_CLIENT_KEY=certs/deploy/gateway/gateway.key

# --- Engine TLS listener (docs/tls-pins.md) ---------------------------------
# Optional. true starts the listener; false closes the port. Default: false
DEVICE_ENGINE_ENABLED=false
# Optional. Default: 0.0.0.0. Use 127.0.0.1 locally, 0.0.0.0 in a container.
DEVICE_ENGINE_HOST=127.0.0.1
# Optional. Must differ from PORT. Default: 3443
DEVICE_ENGINE_PORT=3443
# The four files below are required when DEVICE_ENGINE_ENABLED=true.
# Development: `make setup-all` in the KMS repository puts all four in certs/deploy/gateway.
# Secret. Never put the spare key here.
DEVICE_TLS_KEY=certs/deploy/gateway/engine-server.key
DEVICE_TLS_CERT=certs/deploy/gateway/engine-server.crt
# Start-up fails if the key doesn't match this pin.
DEVICE_TLS_PIN_FILE=certs/deploy/gateway/engine-server.spki.sha256
# Device CAs: device-ca-trust.pem. NOT ca.crt.
DEVICE_CA_BUNDLE=certs/deploy/gateway/device-ca-trust.pem

# --- Master account and free plan (optional) --------------------------------
# Comma-separated emails of the master accounts: no limits, and the only ones
# that can read GET /api/v1/master/metrics. Each counts once its address is
# verified. Unset: no master.
# MASTER_EMAILS=you@cipherion.com,ops@cipherion.com
# Limits for every other account until there's billing. Defaults shown.
# FREE_PLAN_MAX_PROJECTS=1
# FREE_PLAN_MAX_GROUPS_PER_PROJECT=2
# Members besides the project admin, plus open invitations, per group.
# FREE_PLAN_MAX_PEOPLE_PER_GROUP=3
# Active devices per user.
# FREE_PLAN_MAX_DEVICES=1
# Per user, per calendar month (UTC).
# FREE_PLAN_MAX_ENCRYPTIONS_PER_MONTH=500
# FREE_PLAN_MAX_DECRYPTIONS_PER_MONTH=500

# --- NestJS Observe (optional) ----------------------------------------------
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
